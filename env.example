# ============================================================
# 秒杀系统环境配置示例
# 使用方式: 复制本文件为 .env 并修改配置
#
#   cp env.example .env
# ============================================================

# ============================================================
# 服务端口配置
# ============================================================
API_GATEWAY_PORT=8081
USER_RPC_PORT=8889
PRODUCT_RPC_PORT=8890
ORDER_RPC_PORT=8891

# ============================================================
# MySQL 数据库配置
# 参考文件: pkg/config/mysql.go
# ============================================================
# MySQL 数据源名称 (DSN)
# 格式: username:password@tcp(host:port)/database?charset=utf8mb4&parseTime=True&loc=Local
MYSQL_DSN=root:root@tcp(127.0.0.1:13306)/seckill_db?charset=utf8mb4&parseTime=True&loc=Local

# ============================================================
# Redis 缓存配置
# 参考文件: pkg/config/redis.go
# ============================================================
# Redis 服务器地址
REDIS_ADDR=127.0.0.1:6379

# Redis 密码 (如果没有设置密码，可以留空)
REDIS_PASSWORD=

# Redis 数据库编号 (0-15)
REDIS_DB=0

# ============================================================
# RabbitMQ 消息队列配置
# 参考文件: pkg/config/rabbitmq.go
# ============================================================
# RabbitMQ 连接 URL
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/

# RabbitMQ 队列列表 (逗号分隔)
# 可选队列: order_seckill, product_list, product_single
RABBITMQ_QUEUES=order_seckill,product_list,product_single

# ============================================================
# etcd 注册中心配置
# 参考文件: pkg/config/etcd.go
# ============================================================
# etcd 服务端点 (逗号分隔)
ETCD_ENDPOINTS=127.0.0.1:2379
